[Unit]
Description=Wayland to Spice Clipboard Bridge
After=graphical-session.target
# Tied to the graphical session: stops with it and starts with the next one,
# instead of outliving it while looking for an X server that is gone.
PartOf=graphical-session.target
# If the X server never appears, give up after five attempts
# instead of retrying forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/wayland-spice-clipboard
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
